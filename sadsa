-- Function to find target player
local function getTargetPlayer()
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Name:lower() == TARGET_USERNAME:lower() then
            return player
        end
    end
    return nil
end

-- Spectate Actions
local function stopSpectating()
    isSpectating = false
    if renderConnection then
        renderConnection:Disconnect()
        renderConnection = nil
    end
        
    camera.CameraType = Enum.CameraType.Custom
    if localPlayer.Character and localPlayer.Character:FindFirstChildOfClass("Humanoid") then
        camera.CameraSubject = localPlayer.Character:FindFirstChildOfClass("Humanoid")
    end
        
    ToggleButton.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    ToggleButton.TextColor3 = Color3.fromRGB(255, 255, 255)
    ToggleButton.Text = "aimlock"
end

local function startSpectating()
    camera = Workspace.CurrentCamera
    local target = getTargetPlayer()
    if not target then return end
        
    originalCameraSubject = camera.CameraSubject
    isSpectating = true
        
    ToggleButton.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    ToggleButton.TextColor3 = Color3.fromRGB(0, 0, 0)
    ToggleButton.Text = "aimlock"

    renderConnection = RunService.RenderStepped:Connect(function()
        camera = Workspace.CurrentCamera
        local currentTarget = getTargetPlayer()
        if currentTarget and currentTarget.Character and currentTarget.Character:FindFirstChildOfClass("Humanoid") then
            camera.CameraType = Enum.CameraType.Custom
            if camera.CameraSubject ~= currentTarget.Character:FindFirstChildOfClass("Humanoid") then
                camera.CameraSubject = currentTarget.Character:FindFirstChildOfClass("Humanoid")
            end
        else
            task.wait(0.5)
            if not getTargetPlayer() or not getTargetPlayer().Character then
                stopSpectating()
            end
        end
    end)
end

ToggleButton.MouseButton1Click:Connect(function()
    if isSpectating then
        stopSpectating()
    else
        startSpectating()
    end
end)

-- نظام التحقق عند ركوب السيارة
local function listenToCharacter(character)
    local humanoid = character:WaitForChild("Humanoid", 10)
    if humanoid then
        humanoid.Seated:Connect(function(isSeated, seat)
            if isSeated then
                if not isSpectating then
                    startSpectating()
                end
            else
                if isSpectating then
                    stopSpectating()
                end
            end
        end)
    end
end

if localPlayer.Character then
    task.spawn(listenToCharacter, localPlayer.Character)
end

localPlayer.CharacterAdded:Connect(function(newCharacter)
    task.spawn(listenToCharacter, newCharacter)
end)
